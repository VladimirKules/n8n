    {
      "parameters": {
        "jsCode": "// Получаем данные из предыдущего узла\nconst items = $input.all();\n\n// Обрабатываем каждый элемент\nconst processedItems = items.map(item => {\n  // Создаем объект data верхнего уровня\n  const result = {\n    data: {\n      year: parseInt(item.json[\"Год/Месяц\"]),\n      months: [],\n      statistic: {}\n    }\n  };\n\n  // Массив месяцев с русскими названиями для маппинга\n  const monthNames = [\n    \"Январь\", \"Февраль\", \"Март\", \"Апрель\", \"Май\", \"Июнь\",\n    \"Июль\", \"Август\", \"Сентябрь\", \"Октябрь\", \"Ноябрь\", \"Декабрь\"\n  ];\n  \n  // Обрабатываем каждый месяц\n  result.data.months = monthNames.map((monthName, index) => {\n    // Получаем строку дней для текущего месяца\n    const daysString = item.json[monthName] || \"\";\n    \n    return {\n      month: index + 1,\n      days: daysString\n    };\n  });\n  \n  // Статистика\n  result.data.statistic = {\n    workdays: parseInt(item.json[\"Всего рабочих дней\"]),\n    holidays: parseInt(item.json[\"Всего праздничных и выходных дней\"]),\n    hours40: parseFloat(item.json[\"Количество рабочих часов при 40-часовой рабочей неделе\"]),\n    hours36: parseFloat(item.json[\"Количество рабочих часов при 36-часовой рабочей неделе\"]),\n    hours24: parseFloat(item.json[\"Количество рабочих часов при 24-часовой рабочей неделе\"])\n  };\n  \n  return result;\n});\n\nreturn processedItems;"
      },
